{
  "description": "route-guard: o plano aprovado vira uma rota; escopo barrado antes da escrita, critério de pronto rodado por script, parada com passo aberto barrada",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/on_plan_approved.py\" \"${CLAUDE_PLUGIN_DATA}\"", "timeout": 15}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool.py\" \"${CLAUDE_PLUGIN_DATA}\"", "timeout": 10}
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/task_completed.py\" \"${CLAUDE_PLUGIN_DATA}\"", "timeout": 1800}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.py\" \"${CLAUDE_PLUGIN_DATA}\"", "timeout": 30}
        ]
      }
    ]
  }
}
